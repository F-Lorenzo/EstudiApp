{
  "name": "estudiapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node supabase/tests/run.mjs",
    "e2e": "playwright test -c e2e",
    "e2e:supabase": "supabase start --workdir e2e -x imgproxy,logflare,vector,supavisor,postgres-meta,mailpit,studio,realtime,storage-api,edge-runtime",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:db",
    "db:bundle": "node scripts/bundle-migrations.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:demo:cleanup": "node scripts/seed-demo.mjs --cleanup"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@opennextjs/cloudflare": "^1.20.12",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "gsap": "^3.15.0",
    "next": "^16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.1",
    "supabase": "^2.122.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.151.2"
  }
}
