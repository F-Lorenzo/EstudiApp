# Supabase (ver supabase/README.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: se salta la RLS. Nunca al navegador ni a un repo. La usan el pago
# simulado y el webhook de Mercado Pago.
SUPABASE_SERVICE_ROLE_KEY=

# Dominio público de la app, para los enlaces de los emails (opcional en local).
NEXT_PUBLIC_SITE_URL=

# Pago simulado: confirma reservas SIN cobrar, para probar el recorrido mientras no
# esté Mercado Pago. Poné «true» solo en tu máquina; dejalo vacío en cualquier
# entorno real. Aunque se defina, no funciona en producción de Vercel.
ALLOW_SIMULATED_PAYMENTS=

# Mercado Pago (guía: docs/MERCADO-PAGO-CUENTA.md). Todo es solo de servidor; nada va al navegador.
# Credenciales de la aplicación (Tus integraciones → Credenciales de producción o de prueba).
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Solo para probar con cuentas de prueba: «true» vincula a los docentes con credenciales TEST- (test_token=true
# en el canje del código OAuth). Con docentes reales dejalo vacío y volvé a vincularlos.
MERCADOPAGO_OAUTH_TEST_TOKEN=
# Clave secreta de Webhooks: con ella se comprueba que cada aviso de pago lo mandó Mercado Pago.
# Sin esta variable el webhook rechaza todo.
MERCADOPAGO_WEBHOOK_SECRET=
# Cifra los tokens de los docentes antes de guardarlos. 32 bytes en base64: openssl rand -base64 32
# Si se pierde, los docentes tienen que volver a vincular su cuenta; no la cambies con docentes vinculados.
MERCADOPAGO_TOKEN_ENCRYPTION_KEY=

# Videollamada con Daily.co (dashboard.daily.co → Developers → API key). Solo servidor. Sin ella la sala de
# clase muestra que la videollamada no está disponible.
DAILY_API_KEY=

# Emails transaccionales con Resend (hace falta un dominio propio verificado en Resend).
# Sin estas dos, los emails quedan pendientes en la base y no se envía ninguno.
RESEND_API_KEY=
# Remitente, con el subdominio verificado en Resend: EstudiApp <avisos@mail.estudiapp.app>
EMAIL_FROM=
# Opcional: adónde van las respuestas (una casilla que alguien lea), por ejemplo soporte@estudiapp.app.
EMAIL_REPLY_TO=

# Secreto del mantenimiento del cobro (/api/cron/payments-maintenance). Lo usa el cron de Cloudflare (cada hora,
# ver wrangler.jsonc y cloudflare-worker.ts) como «Authorization: Bearer». Sin esta variable la ruta rechaza todo
# y el cron falla. Va como secreto del Worker (Settings → Variables and Secrets), nunca en vars ni en Git.
# Generalo con: openssl rand -hex 32
CRON_SECRET=
